# Copy to .env before running Docker Compose or docker run.
# Replace the API secret. The supplied examples publish the API on localhost only.
UI_SECRET=replace-with-your-secret

# A full Mihomo config from a subscription supplies rules, DNS policy, groups,
# and nodes. Container ports, Zashboard, and NETWORK_MODE remain in effect.
# Node-only subscriptions and SRV node links use the bundled template.
# If several subscriptions contain full configs, the first SUBn by number wins,
# followed by HTTP(S) SRVn. Other configs and extra nodes are not merged into it.
# SUB1=https://your-provider.example/subscription
# SUB2=https://your-other-provider.example/subscription
# SRV1=vless://uuid@server.example:443?security=tls&type=tcp#MyNode

# Full-config refresh, in seconds. Defaults to PROVIDER_INTERVAL (3600).
# Set SUBSCRIPTION_INTERVAL=0 to disable background config refresh.
# SUBSCRIPTION_INTERVAL=3600
# SUBSCRIPTION_TIMEOUT=30

# Explicit CONFIG takes priority over automatic subscription config selection.
# A ready-made YAML file at ./data/config.yaml bypasses env substitution.
# CONFIG=config.yaml

# Optional runtime settings:
# MIXED_PORT=20170
# UI_PORT=9090
# LOG_LEVEL=info
# IPV6=false
# STORE_FAKE_IP=true
# DNS_BOOTSTRAP=1.1.1.1|9.9.9.9
# DNS=https://cloudflare-dns.com/dns-query
# EXTERNAL_UI_URL=https://your-dashboard.example/archive.zip
